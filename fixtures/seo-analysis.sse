e to. Getting smarter every time.\\\">\\r\\n    <meta name=\\\"framer-search-index\\\" content=\\\"https://framerusercontent.com/sites/NTBjAYSIhFRareAOjIDkj/searchIndex-xn84ZuX6yOu6.json\\\">\\r\\n    <meta name=\\\"framer-search-index-fallback\\\" content=\\\"https://framerusercontent.com/sites/NTBjAYSIhFRareAOjIDkj/searchIndex-sHunPTDFP8zS.json\\\">\\r\\n    <meta name=\\\"framer-html-plugin\\\" content=\\\"disable\\\">\\r\\n    <link href=\\\"3fRlxKEgFp8rDriFPbTiKLd2bu4\\\" rel=\\\"icon\\\" media=\\\"(prefers-color-scheme: light)\\\">\\r\\n    <link href=\\\"Tl2uH7xXyiMLApfZo0B2m56a8\\\" rel=\\\"icon\\\" media=\\\"(prefers-color-scheme: dark)\\\">\\r\\n    <!-- Open Graph -->\\r\\n    <meta property=\\\"og:type\\\" content=\\\"website\\\">\\r\\n    <meta property=\\\"og:title\\\" content=\\\"DOJO AI - The Intelligent Marketing System\\\">\\r\\n    <meta property=\\\"og:description\\\" content=\\\"DOJO AI watches every channel, tracks your brand, runs your workflows, and acts before you have to. Getting smarter every time.\\\">\\r\\n    <meta property=\\\"og:image\\\" content=\\\"Sq3Oen1y00YTS5enRR8c38nOEo\\\">\\r\\n    <!-- X -->\\r\\n    <meta name=\\\"twitter:card\\\" content=\\\"summary_large_image\\\">\\r\\n    <meta name=\\\"twitter:title\\\" content=\\\"DOJO AI - The Intelligent Marketing System\\\">\\r\\n    <meta name=\\\"twitter:description\\\" content=\\\"DOJO AI watches every channel, tracks your brand, runs your workflows, and acts before you have to. Getting smarter every time.\\\">\\r\\n    <meta name=\\\"twitter:image\\\" content=\\\"Sq3Oen1y00YTS5enRR8c38nOEo\\\">\\r\\n\\t\\r\\n\\t\\r\\n\\t<script>try{if(localStorage.getItem(\\\"__framer_force_showing_editorbar_since\\\")){const n=document.createElement(\\\"link\\\");n.rel=\\\"modulepreload\\\";n.href=\\\"https://framer.com/edit/init.mjs\\\";document.head.appendChild(n)}}catch(e){}</script>\\r\\n\\t<link rel=\\\"canonical\\\" href=\\\"https://www.example.com/\\\"><meta property=\\\"og:url\\\" content=\\\"https://www.example.com/\\\"><!-- Start of headStart -->\\r\\n    <!-- Snippet: legacy-headEnd -->\\r\\n<script>(function(w){w.fpr=w.fpr||function(){w.fpr.q = w.fpr.q||[];w.fpr.q[arguments[0]=='set'?'unshift':'push'](arguments);};})(window);\\r\\nfpr(\\\"init\\\", {cid:\\\"medtc8g7\\\"}); \\r\\nfpr(\\\"click\\\");\\r\\n</script>\\r\\n<script src=\\\"https://cdn.firstpromoter.com/fpr.js\\\" async></script>\\r\\n\\r\\n<!-- SnippetEnd: legacy-headEnd -->\\r\\n<!-- Snippet: OjoItATb7 -->\\r\\n<script>\\r\\n  window.dataLayer = window.dataLayer || [];\\r\\n  function gtag(){dataLayer.push(arguments);}\\r\\n  \\r\\n  // Enforce a strict \\\"Denied\\\" baseline before anything else can execute\\r\\n  gtag('consent', 'default', {\\r\\n    'ad_storage': 'denied',\\r\\n    'ad_user_data': 'denied',\\r\\n    'ad_personalization': 'denied',\\r\\n    'analytics_storage': 'denied',\\r\\n    'functionality_storage': 'granted',\\r\\n    'security_storage': 'granted',\\r\\n    'wait_for_update': 1500 // Gives Termly 500ms to read cookies before tags fire\\r\\n  });\\r\\n</script> \\r\\n\\r\\n<script data-termly-config>\\r\\n  window.TERMLY_CUSTOM_BLOCKING_MAP = {\\r\\n  \\\"framerusercontent.com\\\": \\\"essential\\\",  \\r\\n  \\\"googletagmanager.com\\\": \\\"essential\\\",  \\r\\n  \\\"tagmanager.google.com\\\": \\\"essential\\\",  \\r\\n  \\\"stdsdodg.eug.stape.io\\\": \\\"essential\\\" // Map your Stape SGTM loader domain\\r\\n  };\\r\\n</script>  \\r\\n\\r\\n<script src=\\\"https://app.termly.io/resource-blocker/00000000-0000-4000-8000-000000000002\\\"></script>\\r\\n\\r\\n<script>\\r\\n(function(w,d,s,l,i){\\r\\n  w[l]=w[l]||[];\\r\\n  w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});\\r\\n  var f=d.getElementsByTagName(s)[0],j=d.createElement(s);\\r\\n  j.async=true;\\r\\n  // Serving GTM dynamically through your custom Stape container URL\\r\\n  j.src=\\\"https://stdsdodg.eug.stape.io/94a97stdsdodg.js?\\\"+i;\\r\\n  f.parentNode.insertBefore(j,f);\\r\\n})(window,document,'script','dataLayer','e5ucuy1=DgBSIycpWT4hXVkjSi8wVRFZXUpC');\\r\\n</script>\\r\\n\\r\\n<script>\\r\\nconst injectTrackingToShadowCal = setInterval(() => {\\r\\n  const calHost = document.querySelector('cal-inline');\\r\\n  let calIframe = null;\\r\\n\\r\\n  if (calHost && calHost.shadowRoot) {\\r\\n    calIframe = calHost.shadowRoot.querySelector('iframe') || document.querySelector('iframe.cal-embed');\\r\\n  } else {\\r\\n    calIframe = document.querySelector('iframe[src*=\\\"cal.eu\\\"]') || document.querySelector('iframe.cal-embed');\\r\\n  }\\r\\n  \\r\\n  if (calIframe) {\\r\\n    clearInterval(injectTrackingToShadowCal);\\r\\n    \\r\\n    const urlParams = new URLSearchParams(window.location.search);\\r\\n    const utms = ['utm_source', 'utm_medium', 'utm_campaign', 'utm_term', 'utm_content'];\\r\\n    let queryPayload = '';\\r\\n    \\r\\n    // 1. UTM Check: Anonymous marketing parameters are generally safe to pass \\r\\n    utms.forEach(param => {\\r\\n      if (urlParams.has(param)) {\\r\\n        queryPayload += `&${param}=${encodeURIComponent(urlParams.get(param))}`;\\r\\n      }\\r\\n    });\\r\\n    \\r\\n    // 2. THE CONSENT GATE: Check Google Consent Mode status before scraping personal identifiers\\r\\n    let isAnalyticsGranted = false;\\r\\n    try {\\r\\n      // Query Google's internal state directly\\r\\n      if (window.google_tag_data && window.google_tag_data.ics) {\\r\\n        const consentState = window.google_tag_data.ics.get('analytics_storage');\\r\\n        // 1 means granted, 2 means denied\\r\\n        if (consentState === 1) isAnalyticsGranted = true;\\r\\n      }\\r\\n    } catch (e) {\\r\\n      console.log(\\\"Consent check fallback initiated:\\\", e);\\r\\n    }\\r\\n\\r\\n    // 3. Only grab the Client ID if the user explicitly clicked \\\"Accept\\\" on Termly\\r\\n    if (isAnalyticsGranted) {\\r\\n      try {\\r\\n        const match = document.cookie.match(/_ga=GA1\\\\.\\\\d+\\\\.(\\\\d+\\\\.\\\\d+)/);\\r\\n        if (match) {\\r\\n          queryPayload += `&GA_client_id=${encodeURIComponent(match[1])}`;\\r\\n        }\\r\\n      } catch (e) {\\r\\n        console.log(\\\"Cookie retrieval bypassed:\\\", e);\\r\\n      }\\r\\n    } else {\\r\\n      console.log(\\\"Analytics consent is DENIED. GA_client_id capture omitted for privacy compliance.\\\");\\r\\n    }\\r\\n    \\r\\n    // 4. Inject whatever payload is legally allowed into the frame\\r\\n    if (queryPayload) {\\r\\n      const currentSrc = calIframe.getAttribute('src');\\r\\n      if (!currentSrc.includes('GA_client_id')) {\\r\\n        const separator = currentSrc.includes('?') ? '&' : '?';\\r\\n        \\r\\n        let metaPayload = '';\\r\\n        utms.forEach(param => {\\r\\n          if (urlParams.has(param)) {\\r\\n            metaPayload += `&metadata[${param} samples]=${encodeURIComponent(urlParams.get(param))}`;\\r\\n          }\\r\\n        });\\r\\n\\r\\n        calIframe.setAttribute('src', currentSrc + separator + queryPayload.substring(1) + metaPayload);\\r\\n        console.log(\\\"Privacy-compliant tracking string initialized.\\\");\\r\\n      }\\r\\n    }\\r\\n  }\\r\\n}, 200);\\r\\n\\r\\nsetTimeout(() => clearInterval(injectTrackingToShadowCal), 6000);\\r\\n</script>\\r\\n<!-- SnippetEnd: OjoItATb7 -->\\r\\n\\r\\n    <!-- End of headStart -->\\r\\n\\t\\r\\n\\t<style data-framer-font-css>/* latin-ext */\\r\\n@font-face {\\r\\n  font-family: 'Sora';\\r\\n  font-style: normal;\\r\\n  font-weight: 400;\\r\\n  font-display: swap;\\r\\n  src: url(https://fonts.gstatic.com/s/sora/v17/xMQOuFFYT72X5wkB_18qmnndmSdSnk-DKQJRBg.woff2) format('woff2');\\r\\n  unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF;\\r\\n}\\r\\n/* latin */\\r\\n@font-face {\\r\\n  font-family: 'Sora';\\r\\n  font-style: normal;\\r\\n  font-weight: 400;\\r\\n  f