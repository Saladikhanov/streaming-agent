data: {"type": "action", "id": "act10", "icon": "google_ads", "title": "Analyzing Google Ads metrics", "results": [], "results_units": "Results", "started_at": "2026-08-01T09:00:48.933176Z", "ended_at": "2026-08-01T09:00:55.443515Z", "input": {"cell_id": "8178f1bc", "execute": true, "source": "\nimport datetime\n\n# Step 1: Get account-level data segmented by campaign to find campaign IDs\ncampaigns_df = await get_google_ads_analytics(\n    segment_dimension='campaign',\n    start_date=datetime.date(2026, 3, 19),\n    end_date=datetime.date(2026, 6, 18),\n)\n\nif campaigns_df is not None:\n    print(f\"Total campaigns: {len(campaigns_df)}\")\n    print(\"Columns:\", campaigns_df.columns.tolist())\n    display(campaigns_df)\nelse:\n    print(\"No data returned.\")\n"}}

