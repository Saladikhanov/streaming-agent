data: {"type": "action", "id": "act11", "icon": "google_ads", "title": "Analyzing Google Ads criteria metrics", "results": [], "results_units": "Results", "started_at": "2026-08-01T09:01:01.065217Z", "ended_at": "2026-08-01T09:01:08.481791Z", "input": {"execute": true, "source": "\n# Get all campaign IDs\ncampaign_ids = campaigns_df['campaign_id'].tolist()\nprint(f\"Campaign IDs: {campaign_ids}\")\n\n# Pull keywords for each campaign and combine\nall_kw = []\nfor cid in campaign_ids:\n    kw_df = await get_google_ads_criteria_analytics(\n        criterion_resource='AD_GROUP_CRITERION',\n        criterion_type='KEYWORD',\n        campaign_id=cid,\n        start_date=datetime.date(2026, 3, 19),\n        end_date=datetime.date(2026, 6, 18),\n    )\n    if kw_df is not None and len(kw_df) > 0:\n        kw_df['campaign_id'] = cid\n        all_kw.append(kw_df)\n\nif all_kw:\n    kw_all = pd.concat(all_kw, ignore_index=True)\n    print(f\"Total keyword rows: {len(kw_all)}\")\n    print(\"Columns:\", kw_all.columns.tolist())\n    display(kw_all.head(3))\nelse:\n    print(\"No keyword data found.\")\n"}}

