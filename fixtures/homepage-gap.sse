data: {"type": "action", "id": "act13", "icon": "load_data", "title": "Loading data", "results": [], "results_units": "Results", "started_at": "2026-08-01T09:01:39.307897Z", "ended_at": "2026-08-01T09:01:44.658300Z", "input": {"execute": true, "source": "\n# Save both datasets to CSV\nawait upload_to_library(\n    gsc_df.to_csv().encode(),\n    \"thread/outputs/GSC Top 50 Queries - example.com (90d).csv\",\n    overwrite=True\n)\n\nawait upload_to_library(\n    gads_top50.to_csv().encode(),\n    \"thread/outputs/Google Ads Top 50 Keywords by Conversions (90d).csv\",\n    overwrite=True\n)\n\nprint(\"Both files saved.\")\n"}}

