data: {"type": "action", "id": "act8", "icon": "table", "title": "Creating table", "results": [], "results_units": "Results", "started_at": "2026-08-01T09:00:35.301910Z", "ended_at": "2026-08-01T09:00:38.337066Z", "input": {"execute": true, "source": "\nimport json\n\n# Parse GSC data into DataFrame\ngsc_raw = json.loads(gsc_data)\ngsc_df = pd.DataFrame([{\n    'Query': r['keys'][0],\n    'Clicks': r['clicks'],\n    'Impressions': r['impressions'],\n    'CTR': round(r['ctr'] * 100, 2),\n    'Avg Position': round(r['position'], 1)\n} for r in gsc_raw])\n\n# Sort by clicks descending\ngsc_df = gsc_df.sort_values('Clicks', ascending=False).reset_index(drop=True)\ngsc_df.index += 1  # 1-indexed rank\nprint(f\"GSC rows: {len(gsc_df)}\")\ndisplay(gsc_df)\n"}}

