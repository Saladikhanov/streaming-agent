data: {"type": "action", "id": "act7", "icon": "google_search_console", "title": "Getting ranked keywords from GSC", "results": [], "results_units": "Results", "started_at": "2026-08-01T09:00:28.054685Z", "ended_at": "2026-08-01T09:00:31.675398Z", "input": {"source": "\nimport pandas as pd\nimport datetime\n\n# Dataset 1 — Google Search Console: Top 50 queries by clicks, last 90 days\ngsc_data = await seo_get_ranked_keywords_gsc(\n    property_url=\"https://www.example.com/\",\n    start_date=datetime.date(2026, 3, 19),\n    end_date=datetime.date(2026, 6, 18),\n    limit=50\n)\nprint(\"GSC DATA:\")\nprint(gsc_data)\n", "execute": true}}

