data: {"type": "action", "id": "act12", "icon": "table", "title": "Creating table", "results": [], "results_units": "Results", "started_at": "2026-08-01T09:01:29.392351Z", "ended_at": "2026-08-01T09:01:36.461507Z", "input": {"execute": true, "source": "\n# Build the Google Ads keywords table — top 50 by conversions\ngads_clean = kw_all[[\n    'criterion_keyword_text',\n    'criterion_keyword_match_type',\n    'conversions',\n    'clicks',\n    'impressions',\n    'cost'\n]].copy()\n\ngads_clean.columns = ['Keyword', 'Match Type', 'Conversions', 'Clicks', 'Impressions', 'Cost (USD)']\n\n# Fill nulls with 0 for numeric columns\ngads_clean['Conversions'] = pd.to_numeric(gads_clean['Conversions'], errors='coerce').fillna(0)\ngads_clean['Clicks'] = pd.to_numeric(gads_clean['Clicks'], errors='coerce').fillna(0).astype(int)\ngads_clean['Impressions'] = pd.to_numeric(gads_clean['Impressions'], errors='coerce').fillna(0).astype(int)\ngads_clean['Cost (USD)'] = pd.to_numeric(gads_clean['Cost (USD)'], errors='coerce').fillna(0).round(2)\n\n# Sort by Conversions desc, then Clicks desc\ngads_top50 = gads_clean.sort_values(['Conversions', 'Clicks'], ascending=[False, False]).head(50).reset_index(drop=True)\ngads_top50.index += 1\n\nprint(f\"Rows returned: {len(gads_top50)}\")\nprint(f\"Keywords with >0 conversions: {(gads_top50['Conversions'] > 0).sum()}\")\nprint(f\"Keywords with >0 clicks: {(gads_top50['Clicks'] > 0).sum()}\")\ndisplay(gads_top50)\n"}}

