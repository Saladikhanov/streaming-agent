data: {"type": "action", "id": "act9", "icon": "google_ads", "title": "Analyzing Google Ads criteria metrics", "results": [], "results_units": "Results", "started_at": "2026-08-01T09:00:41.633728Z", "ended_at": "2026-08-01T09:00:46.001765Z", "input": {"execute": true, "source": "\nimport datetime\n\n# Dataset 2 — Google Ads: Top 50 keywords by conversions, last 90 days\ngads_df = await get_google_ads_criteria_analytics(\n    criterion_resource='AD_GROUP_CRITERION',\n    criterion_type='KEYWORD',\n    start_date=datetime.date(2026, 3, 19),\n    end_date=datetime.date(2026, 6, 18),\n)\n\nif gads_df is not None:\n    print(f\"Total rows: {len(gads_df)}\")\n    print(\"Columns:\", gads_df.columns.tolist())\n    display(gads_df.head(5))\nelse:\n    print(\"No data returned.\")\n"}}

