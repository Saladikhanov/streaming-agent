ll_conversions_by_conversion_date": [null, null, null], "all_conversions_value_by_conversion_date": [null, null, null], "all_conversions_from_interactions_rate": [null, null, null], "cost_per_conversion": [null, null, null], "cost_per_all_conversions": [null, null, null], "value_per_conversion": [null, null, null], "value_per_all_conversions": [null, null, null], "value_per_all_conversions_by_conversion_date": [null, null, null], "value_per_conversions_by_conversion_date": [null, null, null], "current_model_attributed_conversions": [null, null, null], "current_model_attributed_conversions_value": [null, null, null], "value_per_current_model_attributed_conversion": [null, null, null], "cross_device_conversions": [null, null, null], "cross_device_conversions_value": [null, null, null]}}]}

