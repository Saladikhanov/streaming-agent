 NOT in any search query\\n  \\u274c 'living graph' \\u2014 NOT in any search query\\n  \\u274c 'proactive agents' \\u2014 NOT in any search query\\n  \\u274c 'always on capture' \\u2014 NOT in any search query\\n  \\u274c 'intelligent marketing system' \\u2014 NOT in any search query\\n  \\u274c 'one source of truth' \\u2014 NOT in any search query\\n  \\u274c 'compounding loop' \\u2014 NOT in any search query\\n  \\u274c 'challenger' \\u2014 NOT in any search query\\n  \\u274c 'system of record' \\u2014 NOT in any search query\\n  \\u274c 'graph' \\u2014 NOT in any search query\\n\"}]", "has_succeeded": true, "artifacts": [{"id": "table-b2c", "type": "table", "columns": {"index": [14, 1, 13, 6, 3, 15, 11, 8, 9, 17, 10, 12, 16, 2, 0, 7, 4, 5], "Keyword": ["marketing intelligence software", "ai marketing intelligence", "marketing intelligence platform", "b2b marketing automation platforms", "ai marketing software", "marketing operations platform", "marketing data platform", "email marketing campaign", "marketing ai platform", "unified marketing analytics", "marketing analytics software", "marketing data platform", "marketing workflow automation", "ai marketing platform", "ai marketing automation", "b2b marketing automation software", "ai marketing system", "ai video ads"], "Match Type": ["BROAD", "PHRASE", "PHRASE", "BROAD", "PHRASE", "PHRASE", "BROAD", "BROAD", "PHRASE", "BROAD", "PHRASE", "PHRASE", "BROAD", "EXACT", "PHRASE", "PHRASE", "BROAD", "BROAD"], "Conversions": [128, 96, 76, 34, 29, 15, 14, 13, 12, 11, 10, 8, 4, 3, 2, 1, 1, 1], "Homepage Match": ["MISSING terms: software", "Partial match", "MISSING terms: platform", "MISSING terms: platform, automation, b2b", "MISSING terms: software", "MISSING terms: platform, operations", "MISSING terms: platform, data platform", "Partial match", "MISSING terms: platform", "MISSING terms: analytics, unified", "MISSING terms: software, analytics", "MISSING terms: platform, data platform", "MISSING terms: automation", "MISSING terms: platform", "MISSING terms: automation", "MISSING terms: software, automation, b2b", "Partial match", "Partial match"]}}]}

