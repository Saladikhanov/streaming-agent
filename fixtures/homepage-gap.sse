data: {"type": "action", "id": "act17", "icon": "notebook", "title": "Coding", "results": [], "results_units": "Results", "started_at": "2026-08-01T09:02:47.311252Z", "ended_at": "2026-08-01T09:03:29.472783Z", "input": {"source": "\nimport pandas as pd\n\n# ---- Homepage copy: key phrases extracted from live page ----\nhomepage_phrases = [\n    \"intelligent marketing system\",\n    \"watches every channel\",\n    \"tracks your brand\",\n    \"runs your workflows\",\n    \"acts before you have to\",\n    \"getting smarter every time\",\n    \"ask anything see everything\",\n    \"proactive dashboard\",\n    \"marketing and revenue\",\n    \"revenue intelligence\",\n    \"pre-built workflows\",\n    \"do in minutes\",\n    \"shared context\",\n    \"one source of truth\",\n    \"on-brand content\",\n    \"branded content\",\n    \"brand voice\",\n    \"compounding intelligence\",\n    \"living graph\",\n    \"proactive agents\",\n    \"always on capture\",\n    \"always on\",\n    \"brand measurement\",\n    \"performance marketing\",\n    \"organic channels\",\n    \"sales intelligence\",\n    \"seo\",\n    \"aeo\",\n    \"personal branding\",\n    \"graph\",\n    \"system\",\n    \"workflows\",\n    \"dashboard\",\n    \"campaigns\",\n    \"channel\",\n    \"data\",\n    \"intelligence\",\n    \"ai\",\n    \"marketing\",\n]\n\nhomepage_text = \"\"\"\nThe intelligent marketing system. DOJO watches every channel, tracks your brand,\nruns your workflows, and acts before you have to. Getting smarter every time.\nAsk anything. See everything. Proactive Dashboard. Marketing and revenue, finally\nin the same room. Revenue Intelligence. Do in minutes what used to take days.\nPre-built Workflows. One source of truth for your whole team. Shared Context.\nBranded content without leaving the conversation. On-brand content. One system.\nEvery marketing function. DOJO's compounding intelligence. Living graph.\nProactive agents. Compounding loop. Always on-capture. Brand measurement.\nPerformance marketing. SEO/AEO. Organic channels. Personal branding.\nSales intelligence.\n\"\"\".lower()\n\n# ---- Top converting paid keywords ----\npaid_kws = [\n    (\"marketing intelligence software\", \"BROAD\", 128),\n    (\"ai marketing intelligence\", \"PHRASE\", 96),\n    (\"marketing intelligence platform\", \"PHRASE\", 76),\n    (\"b2b marketing automation platforms\", \"BROAD\", 34),\n    (\"ai marketing software\", \"PHRASE\", 29),\n    (\"marketing operations platform\", \"PHRASE\", 15),\n    (\"marketing data platform\", \"BROAD\", 14),\n    (\"email marketing campaign\", \"BROAD\", 13),\n    (\"marketing ai platform\", \"PHRASE\", 12),\n    (\"unified marketing analytics\", \"BROAD\", 11),\n    (\"marketing analytics software\", \"PHRASE\", 10),\n    (\"marketing data platform\", \"PHRASE\", 8),\n    (\"marketing workflow automation\", \"BROAD\", 4),\n    (\"b2b marketing automation software\", \"PHRASE\", 1),\n    (\"ai marketing system\", \"BROAD\", 1),\n    (\"ai marketing automation\", \"PHRASE\", 1),\n    (\"ai video ads\", \"BROAD\", 1),\n    (\"ai marketing platform\", \"EXACT\", 3),\n    (\"ai marketing automation\", \"PHRASE\", 1),\n]\n\ndf_paid = pd.DataFrame(paid_kws, columns=[\"Keyword\", \"Match Type\", \"Conversions\"])\ndf_paid = df_paid.groupby([\"Keyword\", \"Match Type\"], as_index=False)[\"Conversions\"].sum()\ndf_paid = df_paid.sort_values(\"Conversions\", ascending=False)\n\n# ---- Non-branded GSC queries ----\ngsc_non_brand = [\n    (\"marketing os\", 35, 6.0),\n    (\"marketing operating system\", 25, 5.6),\n    (\"ai marketing operating system\", 9, 5.4),\n    (\"ai marketing os\", 3, 9.9),\n    (\"marketingos\", 2, 6.9),\n    (\"what is a marketing operating system\", 3, 1.8),\n    (\"aeo best practices 2026\", 1, 10.5),\n    (\"aeo 2026\", 1, 7.7),\n    (\"aeo in 2026\", 1, 10.4),\n    (\"ai marketing blog\", 1, 26.2),\n    (\"ai prompts for marketing campaigns\", 1, 23.0),\n    (\"marketing prompts\", 2, 26.8),\n]\ndf_gsc = pd.DataFrame(gsc_non_brand, columns=[\"Query\", \"Clicks\", \"Avg Position\"])\n\n# ---- Check which high-converting paid keywords are absent from homepage ----\ndef keyword_in_homepage(kw, homepage):\n    # Check if ALL words in keyword appear in homepage text\n    words = kw.lower().split()\n    # Also check the full phrase\n    if kw.lower() in homepage:\n        return \"Full phrase present\"\n    # Check key discriminating terms\n    key_terms = {\n        \"intelligence\": \"intelligence\" in homepage,\n        \"software\": \"software\" in homepage,\n        \"platform\": \"platform\" in homepage,\n        \"automation\": \"automation\" in homepage,\n        \"analytics\": \"analytics\" in homepage,\n        \"operations\": \"operations\" in homepage,\n        \"b2b\": \"b2b\" in homepage,\n        \"unified\": \"unified\" in homepage,\n        \"data platform\": \"data platform\" in homepage,\n    }\n    missing = [k for k, v in key_terms.items() if not v and k in kw.lower()]\n    if missing:\n        return f\"MISSING terms: {', '.join(missing)}\"\n    return \"Partial match\"\n\ndf_paid[\"Homepage Match\"] = df_paid[\"Keyword\"].apply(lambda x: keyword_in_homepage(x, homepage_text))\nprint(\"=== PAID KEYWORDS vs HOMEPAGE ===\")\ndisplay(df_paid[df_paid[\"Conversions\"] >= 1][[\"Keyword\", \"Match Type\", \"Conversions\", \"Homepage Match\"]])\n\nprint(\"\\n=== HOMEPAGE TERMS NOT IN SEARCH DATA ===\")\nhomepage_unique = [\n    \"compounding intelligence\",\n    \"living graph\",\n    \"proactive agents\",\n    \"always on capture\",\n    \"intelligent marketing system\",\n    \"one source of truth\",\n    \"compounding loop\",\n    \"challenger\",\n    \"system of record\",\n    \"graph\",\n]\nall_queries_text = \" \".join([k[0].lower() for k in paid_kws] + [k[0].lower() for k in gsc_non_brand])\nfor term in homepage_unique:\n    present = term.lower() in all_queries_text\n    print(f\"  {'✅' if present else '❌'} '{term}' {'found in search data' if present else '— NOT in any search query'}\")\n"}}

