data: {"type": "action", "id": "act16", "icon": "load_data", "title": "Loading data", "results": [], "results_units": "Results", "started_at": "2026-08-01T09:06:10.986463Z", "ended_at": "2026-08-01T09:06:12.753613Z", "input": {"source": "\nchannel = await read_table('website_account_daily_stats', dim_name='default_channel_group')\npages = await read_table('website_account_daily_stats', dim_name='page')\ncountry = await read_table('website_account_daily_stats', dim_name='country')\nprint(channel.shape, pages.shape, country.shape)\n"}}

