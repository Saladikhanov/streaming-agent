, labels={'platform':'Platform','count':'Posts','content_type':'Content Type'})\n\navg_eng_tbl = avg_eng.rename(columns={'platform':'Platform','avg_engagement_rate':'Avg Engagement Rate','n':'# Posts'})\n\ntop_posts_tbl = top_posts.rename(columns={'platform':'Platform','created_at':'Date','text_content':'Excerpt','content_type':'Type',\n                                            'n_impressions':'Impressions','n_likes':'Likes','n_comments':'Comments','n_shares':'Shares',\n                                            'n_engagements':'Engagements','engagement_rate':'Engagement Rate','post_url':'URL'})\n\nprint(\"done\")\n"}}

