data: {"type": "action", "id": "act9", "icon": "chart", "title": "Creating chart", "results": [], "results_units": "Results", "started_at": "2026-08-01T09:03:04.244015Z", "ended_at": "2026-08-01T09:03:07.437290Z", "input": {"source": "\n# Engagement over time by platform (weekly resample for readability)\neng = daily[daily['platform']!='all'][['platform','day','n_impressions','n_engagements','engagement_rate']].copy()\neng['day'] = pd.to_datetime(eng['day'])\neng_weekly = eng.set_index('day').groupby('platform').resample('W')[['n_impressions','n_engagements']].sum(min_count=1).reset_index()\n\nfig4 = px.line(eng_weekly, x='day', y='n_impressions', color='platform', title='Weekly Impressions by Platform')\nfig4.show()\n\nfig5 = px.line(eng_weekly, x='day', y='n_engagements', color='platform', title='Weekly Engagements by Platform')\nfig5.show()\n\nprint(eng.groupby('platform')[['n_impressions','n_engagements']].sum(min_count=1))\n"}}

event: final
