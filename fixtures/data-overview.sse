data: {"type": "action", "id": "act24", "icon": "chart", "title": "Creating chart", "results": [], "results_units": "Results", "started_at": "2026-08-01T09:09:25.558320Z", "ended_at": "2026-08-01T09:09:30.212970Z", "input": {"source": "\n# recompute social weekly engagement (was overwritten by GA section variable name collision)\neng_social = daily[daily['platform']!='all'][['platform','day','n_impressions','n_engagements']].copy()\neng_social['day'] = pd.to_datetime(eng_social['day'])\neng_social_weekly = eng_social.set_index('day').groupby('platform').resample('W')[['n_impressions','n_engagements']].sum(min_count=1).reset_index()\n\nfig_impressions = px.line(eng_social_weekly, x='day', y='n_impressions', color='platform', title='Weekly Impressions by Platform', labels={'day':'Week','n_impressions':'Impressions','platform':'Platform'})\nfig_engagements = px.line(eng_social_weekly, x='day', y='n_engagements', color='platform', title='Weekly Engagements by Platform', labels={'day':'Week','n_engagements':'Engagements','platform':'Platform'})\nfig_content_type = px.bar(ct, x='platform', y='count', color='content_type', title='Post Content Type by Platform', barmode='stack', labels={'platform':'Platform','count':'Posts','content_type':'Content Type'})\nprint(\"ok\")\n"}}

