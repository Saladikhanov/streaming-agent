data: {"type": "action", "id": "act15", "icon": "chart", "title": "Creating chart", "results": [], "results_units": "Results", "started_at": "2026-08-01T09:05:59.094238Z", "ended_at": "2026-08-01T09:06:03.440605Z", "input": {"source": "\nimport plotly.express as px\n\ndaily_all['day'] = pd.to_datetime(daily_all['day'])\nweekly = daily_all.set_index('day').resample('W')[['n_pageviews','n_sessions','n_uniques','n_new_users']].sum().reset_index()\n\nfig1 = px.line(weekly, x='day', y=['n_pageviews','n_sessions','n_uniques'], title='Weekly Website Traffic (Pageviews, Sessions, Uniques)')\nfig1.show()\n\nfig2 = px.line(weekly, x='day', y='n_new_users', title='Weekly New Users')\nfig2.show()\n\n# Engagement rate & avg session duration trend\neng_weekly = daily_all.set_index('day').resample('W').agg({'engagement_rate':'mean','average_session_duration':'mean'}).reset_index()\nfig3 = px.line(eng_weekly, x='day', y='engagement_rate', title='Weekly Avg Engagement Rate')\nfig3.show()\n\nprint(\"Totals over full period:\")\nprint(daily_all[['n_pageviews','n_sessions','n_uniques','n_new_users','total_revenue','n_purchases']].sum())\n"}}

