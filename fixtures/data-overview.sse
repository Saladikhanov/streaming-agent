data: {"type": "action", "id": "act27", "icon": "notebook", "title": "Coding", "results": [], "results_units": "Results", "started_at": "2026-08-01T09:10:00.734248Z", "ended_at": "2026-08-01T09:10:07.728048Z", "input": {"source": "\ndef df_to_html_table(df, float_cols=None, pct_cols=None):\n    d = df.copy()\n    if float_cols:\n        for c in float_cols:\n            d[c] = d[c].map(lambda x: f\"{x:,.0f}\" if pd.notna(x) else \"-\")\n    if pct_cols:\n        for c in pct_cols:\n            d[c] = d[c].map(lambda x: f\"{x*100:.1f}%\" if pd.notna(x) else \"-\")\n    return d.to_html(index=False, classes='data-table', border=0, escape=True)\n\nlifetime_html = df_to_html_table(lifetime_tbl.rename(columns={'platform':'Platform','total_followers':'Followers','total_following':'Following','total_posts':'Total Posts'}),\n                                   float_cols=['Followers','Following','Total Posts'])\n\navg_eng_html = df_to_html_table(avg_eng_tbl, pct_cols=['Avg Engagement Rate'])\n\ntop_posts_disp = top_posts_tbl.copy()\ntop_posts_disp['Date'] = pd.to_datetime(top_posts_disp['Date']).dt.strftime('%Y-%m-%d')\ntop_posts_disp['Engagement Rate'] = top_posts_disp['Engagement Rate'].map(lambda x: f\"{x*100:.1f}%\")\ntop_posts_disp = top_posts_disp[['Date','Excerpt','Type','Impressions','Likes','Comments','Shares','Engagements','Engagement Rate']]\ntop_posts_html = top_posts_disp.to_html(index=False, classes='data-table', border=0, escape=True)\n\nchannel_html = df_to_html_table(channel_agg.rename(columns={'dim_value':'Channel','n_sessions':'Sessions','n_pageviews':'Pageviews'}),\n                                  float_cols=['Sessions','Pageviews'])\n\npages_html = df_to_html_table(top_pages.rename(columns={'dim_value':'Page','n_pageviews':'Pageviews','n_sessions':'Sessions'}),\n                                float_cols=['Pageviews','Sessions'])\n\ncountries_html = df_to_html_table(top_countries.rename(columns={'dim_value':'Country','n_sessions':'Sessions'}),\n                                    float_cols=['Sessions'])\n\nga_totals = pd.DataFrame({\n    'Metric': ['Pageviews','Sessions','Unique Users','New Users','Total Revenue','Purchases'],\n    'Value': [104806, 79505, 68897, 54150, 0, 0]\n})\nga_totals_html = df_to_html_table(ga_totals, float_cols=['Value'])\n\nprint(\"tables built\")\n"}}

