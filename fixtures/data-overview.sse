data: {"type": "action", "id": "act17", "icon": "chart", "title": "Creating chart", "results": [], "results_units": "Results", "started_at": "2026-08-01T09:07:01.792669Z", "ended_at": "2026-08-01T09:07:04.076986Z", "input": {"source": "\n# Channel group traffic share\nchannel_agg = channel.groupby('dim_value')[['n_sessions','n_pageviews']].sum().sort_values('n_sessions', ascending=False).reset_index()\nfig1 = px.pie(channel_agg, names='dim_value', values='n_sessions', title='Sessions by Channel Group')\nfig1.show()\ndisplay(channel_agg)\n\n# Channel trend over time\nchannel['day'] = pd.to_datetime(channel['day'])\nch_weekly = channel.set_index('day').groupby('dim_value').resample('W')['n_sessions'].sum().reset_index()\nfig2 = px.line(ch_weekly, x='day', y='n_sessions', color='dim_value', title='Weekly Sessions by Channel Group')\nfig2.show()\n"}}

event: final
