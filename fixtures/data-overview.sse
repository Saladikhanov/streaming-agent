data: {"type": "action", "id": "act25", "icon": "chart", "title": "Creating chart", "results": [], "results_units": "Results", "started_at": "2026-08-01T09:09:39.223353Z", "ended_at": "2026-08-01T09:09:42.681066Z", "input": {"source": "\n# GA figures with unique names\nfig_ga_traffic = px.line(weekly, x='day', y=['n_pageviews','n_sessions','n_uniques'], title='Weekly Website Traffic (Pageviews, Sessions, Uniques)', labels={'day':'Week','value':'Count','variable':'Metric'})\nfig_ga_newusers = px.line(weekly, x='day', y='n_new_users', title='Weekly New Users', labels={'day':'Week','n_new_users':'New Users'})\nfig_ga_engrate = px.line(eng_weekly, x='day', y='engagement_rate', title='Weekly Avg Engagement Rate', labels={'day':'Week','engagement_rate':'Engagement Rate'})\nfig_ga_channel_pie = px.pie(channel_agg, names='dim_value', values='n_sessions', title='Sessions by Channel Group')\nfig_ga_channel_trend = px.line(ch_weekly, x='day', y='n_sessions', color='dim_value', title='Weekly Sessions by Channel Group', labels={'day':'Week','n_sessions':'Sessions','dim_value':'Channel'})\nfig_ga_pages = px.bar(top_pages.sort_values('n_pageviews'), x='n_pageviews', y='dim_value', orientation='h', title='Top 10 Pages by Pageviews (all time)', labels={'n_pageviews':'Pageviews','dim_value':'Page'})\nfig_ga_countries = px.bar(top_countries, x='dim_value', y='n_sessions', title='Top 10 Countries by Sessions', labels={'dim_value':'Country','n_sessions':'Sessions'})\nprint(\"ok\")\n"}}

