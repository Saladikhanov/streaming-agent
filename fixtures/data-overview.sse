data: {"type": "action", "id": "act10", "icon": "chart", "title": "Creating chart", "results": [], "results_units": "Results", "started_at": "2026-08-01T09:03:13.820505Z", "ended_at": "2026-08-01T09:03:16.454215Z", "input": {"source": "\ntop_posts = posts.sort_values('n_engagements', ascending=False)[['platform','created_at','text_content','content_type','n_impressions','n_likes','n_comments','n_shares','n_engagements','engagement_rate','post_url']].head(10)\ntop_posts['text_content'] = top_posts['text_content'].str.slice(0,80)\ndisplay(top_posts)\n\n# Content type distribution\nct = posts.groupby(['platform','content_type']).size().reset_index(name='count')\nfig6 = px.bar(ct, x='platform', y='count', color='content_type', title='Post Content Type by Platform', barmode='stack')\nfig6.show()\n\n# Avg engagement rate by platform\navg_eng = posts.groupby('platform').agg(avg_engagement_rate=('engagement_rate','mean'), n=('post_id','count')).reset_index()\ndisplay(avg_eng)\n"}}

