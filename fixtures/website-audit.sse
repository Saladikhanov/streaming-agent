data: {"type": "action", "id": "act10", "icon": "notebook", "title": "Coding", "results": [], "results_units": "Results", "started_at": "2026-08-01T09:11:22.926029Z", "ended_at": "2026-08-01T09:12:00.426326Z", "input": {"source": "\n# --- Build the document ---\n\n# Title page\np = doc.add_paragraph()\np.alignment = WD_ALIGN_PARAGRAPH.CENTER\np.paragraph_format.space_before = Pt(40)\nrun = p.add_run(\"DOJO AI\")\nrun.bold = True\nrun.font.size = Pt(28)\nrun.font.color.rgb = RGBColor(0x1A, 0x1A, 0x8E)\nrun.font.name = 'Calibri'\n\np2 = doc.add_paragraph()\np2.alignment = WD_ALIGN_PARAGRAPH.CENTER\nrun2 = p2.add_run(\"Competitor Website Analysis\")\nrun2.bold = True\nrun2.font.size = Pt(20)\nrun2.font.color.rgb = RGBColor(0x1A, 0x1A, 0x2E)\nrun2.font.name = 'Calibri'\n\np3 = doc.add_paragraph()\np3.alignment = WD_ALIGN_PARAGRAPH.CENTER\nrun3 = p3.add_run(\"Messaging, Positioning, and Website Strategy Lessons\")\nrun3.italic = True\nrun3.font.size = Pt(12)\nrun3.font.color.rgb = RGBColor(0x55, 0x55, 0x99)\nrun3.font.name = 'Calibri'\n\np4 = doc.add_paragraph()\np4.alignment = WD_ALIGN_PARAGRAPH.CENTER\nrun4 = p4.add_run(\"Prepared June 2026\")\nrun4.font.size = Pt(10.5)\nrun4.font.color.rgb = RGBColor(0x88, 0x88, 0x88)\nrun4.font.name = 'Calibri'\n\ndoc.add_page_break()\n\n# --- Executive Summary ---\nadd_heading1(doc, \"Executive Summary\")\nadd_horizontal_rule(doc)\nadd_body(doc, \"This document analyses the websites of five key competitors to DOJO AI, examining how they communicate their value proposition, structure their messaging, and build trust with visitors. The goal is to identify what is working well, what is not, and to extract concrete, actionable lessons for improving DOJO's own website.\")\nadd_body(doc, \"The overarching finding is this: the most effective websites in this space do not lead with features or technology. They lead with a clear, specific outcome, build credibility quickly, and defer technical depth to lower sections of the page. DOJO's website should follow the same principle.\")\nadd_body(doc, \"A secondary finding: Hightouch, the highest-threat competitor, has recently made a significant positioning pivot. They have moved away from their data-first identity and are now claiming the same brand-aware AI marketing territory that DOJO occupies. This overlap demands attention and a sharper response on DOJO's part.\")\n\ndoc.add_page_break()\n\n# --- Competitor Profiles ---\nadd_heading1(doc, \"Competitor Profiles\")\nadd_horizontal_rule(doc)\n\n# --- HubSpot ---\nadd_heading2(doc, \"1. HubSpot\")\np = doc.add_paragraph()\nrun = p.add_run(\"Threat Level: High\")\nrun.bold = True\nrun.font.color.rgb = RGBColor(0xC0, 0x30, 0x30)\nrun.font.name = 'Calibri'\nrun.font.size = Pt(10.5)\n\nadd_table(doc,\n    [\"Element\", \"Detail\"],\n    [\n        [\"Headline\", '\"Where go-to-market teams go to grow.\"'],\n        [\"Headline Style\", \"Outcome-focused, simple, business-first\"],\n        [\"Primary CTA\", \"Get Started\"],\n        [\"Secondary CTA\", \"Get a Demo\"],\n    ]\n)\n\nadd_heading3(doc, \"Core Value Proposition\")\nadd_body(doc, '\"Grow your business with a connected customer platform.\" The message is built around a clear customer problem (disconnected tools) and a clear promised outcome (growth). It is immediately understandable to anyone, regardless of technical background.')\n\nadd_heading3(doc, \"Messaging Themes\")\nadd_bullet(doc, \"Primary: Growth\")\nadd_bullet(doc, \"Secondary: Simplicity\")\nadd_bullet(doc, \"Supporting: Unified customer data, customer experience, ease of use\")\n\nadd_heading3(doc, \"What They Do Well\")\nadd_body(doc, \"HubSpot's website is structured around trust before product. The above-the-fold message is not about AI, not about features, and not about integrations. It is about a business result. This is a deliberate strategic choice that lowers cognitive load and maximises immediate resonance with the CMO and VP-level buyer. The site builds comprehension in under five seconds.\")\nadd_body(doc, \"Notably, AI is not the headline. Growth is. AI appears as an enabler further down the page, not as the lead hook. This reflects a mature understanding of how most buyers actually think: they want to grow the business, and they are willing to use AI to do it — but 'AI' alone is not the outcome they are buying.\")\n\nadd_heading3(doc, \"Key Lessons for DOJO\")\nadd_bullet(doc, \"Lead with outcomes before technology. Growth, clarity, efficiency — not 'intelligent marketing system.'\")\nadd_bullet(doc, \"Reduce complexity above the fold. The value must be immediately obvious without interpretation.\")\nadd_bullet(doc, \"Build trust before explaining how the product works.\")\n\nadd_horizontal_rule(doc)\n\n# --- Salesforce ---\nadd_heading2(doc, \"2. Salesforce Agentforce\")\np = doc.add_paragraph()\nrun = p.add_run(\"Threat Level: Medium\")\nrun.bold = True\nrun.font.color.rgb = RGBColor(0xC0, 0x80, 0x00)\nrun.font.name = 'Calibri'\nrun.font.size = Pt(10.5)\n\nadd_table(doc,\n    [\"Element\", \"Detail\"],\n    [\n        [\"Headline\", '\"Deploy autonomous AI agents to support your employees and customers 24/7.\"'],\n        [\"Headline Style\", \"AI-first, transformational, enterprise-focused\"],\n        [\"Primary CTA\", \"Watch Demo\"],\n        [\"Secondary CTA\", \"Start Building\"],\n    ]\n)\n\nadd_heading3(doc, \"Core Value Proposition\")\nadd_body(doc, '\"Deploy trusted AI agents that can autonomously take action across your business.\" Unlike HubSpot, Salesforce positions AI as the product itself, not a feature of it. The value proposition centres on autonomous action and digital labour rather than growth or simplicity.')\n\nadd_heading3(doc, \"Messaging Themes\")\nadd_bullet(doc, \"Primary: AI agents\")\nadd_bullet(doc, \"Secondary: Automation\")\nadd_bullet(doc, \"Supporting: Productivity, scalability, digital labour, enterprise transformation, trust\")\n\nadd_heading3(doc, \"What They Do Well\")\nadd_body(doc, \"Salesforce has created a new category with Agentforce rather than positioning it as a feature upgrade to an existing product. The messaging leads with transformation, frames AI as an active operator rather than a passive assistant, and creates a sense of urgency around the shift to agentic work. This is category creation at scale, and it is executed with considerable confidence.\")\nadd_body(doc, 'The emphasis on \"trust\" is also noteworthy. At an enterprise level, deploying autonomous agents raises governance and reliability concerns. Salesforce addresses this directly in the headline rather than burying it in a trust page.')\n\nadd_heading3(doc, \"Key Lessons for DOJO\")\nadd_bullet(doc, \"Do not position AI as a helper. Position it as an active operator with real agency.\")\nadd_bullet(doc, \"Category creation is more powerful than feature differentiation. DOJO should be owning and defining 'intelligent marketing system' as a category — not competing within someone else's.\")\nadd_bullet(doc, \"Lead with transformation. The visitor should feel that not using this product means falling behind.\")\n\nadd_horizontal_rule(doc)\n\nprint(\"Page 1-2 done\")\n"}}

