data: {"type": "action", "id": "act11", "icon": "load_data", "title": "Loading data", "results": [], "results_units": "Results", "started_at": "2026-08-01T09:12:04.736958Z", "ended_at": "2026-08-01T09:12:36.026675Z", "input": {"source": "\nfrom docx import Document\nfrom docx.shared import Pt, RGBColor, Inches, Cm\nfrom docx.enum.text import WD_ALIGN_PARAGRAPH\nfrom docx.enum.table import WD_TABLE_ALIGNMENT\nfrom docx.oxml.ns import qn\nfrom docx.oxml import OxmlElement\nimport re\n\nawait download_from_library(\"outputs/DOJO Website Competitor Analysis.md\", \"competitor_analysis.md\")\n\nwith open(\"competitor_analysis.md\", \"r\") as f:\n    content = f.read()\n\ndoc = Document()\n\n# --- Page margins ---\nsection = doc.sections[0]\nsection.top_margin = Cm(2.5)\nsection.bottom_margin = Cm(2.5)\nsection.left_margin = Cm(2.8)\nsection.right_margin = Cm(2.8)\n\n# --- Helper functions ---\n\ndef add_heading1(doc, text):\n    p = doc.add_paragraph()\n    p.paragraph_format.space_before = Pt(18)\n    p.paragraph_format.space_after = Pt(4)\n    run = p.add_run(text)\n    run.bold = True\n    run.font.size = Pt(20)\n    run.font.color.rgb = RGBColor(0x0D, 0x0D, 0x2B)\n    run.font.name = 'Calibri'\n\ndef add_heading2(doc, text):\n    p = doc.add_paragraph()\n    p.paragraph_format.space_before = Pt(16)\n    p.paragraph_format.space_after = Pt(3)\n    run = p.add_run(text)\n    run.bold = True\n    run.font.size = Pt(15)\n    run.font.color.rgb = RGBColor(0x1A, 0x1A, 0x8E)\n    run.font.name = 'Calibri'\n\ndef add_heading3(doc, text):\n    p = doc.add_paragraph()\n    p.paragraph_format.space_before = Pt(10)\n    p.paragraph_format.space_after = Pt(2)\n    run = p.add_run(text)\n    run.bold = True\n    run.font.size = Pt(11)\n    run.font.color.rgb = RGBColor(0x2E, 0x2E, 0x6E)\n    run.font.name = 'Calibri'\n\ndef add_body(doc, text):\n    p = doc.add_paragraph()\n    p.paragraph_format.space_before = Pt(2)\n    p.paragraph_format.space_after = Pt(5)\n    parts = re.split(r'\\*\\*(.*?)\\*\\*', text)\n    for i, part in enumerate(parts):\n        run = p.add_run(part)\n        run.bold = (i % 2 == 1)\n        run.font.size = Pt(10.5)\n        run.font.name = 'Calibri'\n        run.font.color.rgb = RGBColor(0x1A, 0x1A, 0x2E)\n\ndef add_body_italic(doc, text):\n    p = doc.add_paragraph()\n    p.paragraph_format.space_before = Pt(2)\n    p.paragraph_format.space_after = Pt(5)\n    run = p.add_run(text)\n    run.italic = True\n    run.font.size = Pt(10.5)\n    run.font.name = 'Calibri'\n    run.font.color.rgb = RGBColor(0x44, 0x44, 0x66)\n\ndef add_bullet(doc, text):\n    p = doc.add_paragraph(style='List Bullet')\n    p.paragraph_format.space_before = Pt(1)\n    p.paragraph_format.space_after = Pt(2)\n    p.paragraph_format.left_indent = Inches(0.3)\n    parts = re.split(r'\\*\\*(.*?)\\*\\*', text)\n    for i, part in enumerate(parts):\n        run = p.add_run(part)\n        run.bold = (i % 2 == 1)\n        run.font.size = Pt(10.5)\n        run.font.name = 'Calibri'\n        run.font.color.rgb = RGBColor(0x1A, 0x1A, 0x2E)\n\ndef add_note_box(doc, text):\n    p = doc.add_paragraph()\n    p.paragraph_format.space_before = Pt(8)\n    p.paragraph_format.space_after = Pt(8)\n    p.paragraph_format.left_indent = Inches(0.35)\n    pPr = p._p.get_or_add_pPr()\n    pBdr = OxmlElement('w:pBdr')\n    left = OxmlElement('w:left')\n    left.set(qn('w:val'), 'single')\n    left.set(qn('w:sz'), '8')\n    left.set(qn('w:space'), '12')\n    left.set(qn('w:color'), 'C05A00')\n    pBdr.append(left)\n    pPr.append(pBdr)\n    run = p.add_run(\"Important Note: \")\n    run.bold = True\n    run.font.color.rgb = RGBColor(0xC0, 0x5A, 0x00)\n    run.font.name = 'Calibri'\n    run.font.size = Pt(10.5)\n    run2 = p.add_run(text)\n    run2.font.color.rgb = RGBColor(0x1A, 0x1A, 0x2E)\n    run2.font.name = 'Calibri'\n    run2.font.size = Pt(10.5)\n\ndef add_blockquote(doc, text):\n    p = doc.add_paragraph()\n    p.paragraph_format.left_indent = Inches(0.5)\n    p.paragraph_format.space_before = Pt(6)\n    p.paragraph_format.space_after = Pt(6)\n    pPr = p._p.get_or_add_pPr()\n    pBdr = OxmlElement('w:pBdr')\n    left = OxmlElement('w:left')\n    left.set(qn('w:val'), 'single')\n    left.set(qn('w:sz'), '6')\n    left.set(qn('w:space'), '12')\n    left.set(qn('w:color'), '2E2E6E')\n    pBdr.append(left)\n    pPr.append(pBdr)\n    run = p.add_run(text)\n    run.italic = True\n    run.font.size = Pt(10.5)\n    run.font.name = 'Calibri'\n    run.font.color.rgb = RGBColor(0x44, 0x44, 0x88)\n\ndef add_hr(doc):\n    p = doc.add_paragraph()\n    p.paragraph_format.space_before = Pt(4)\n    p.paragraph_format.space_after = Pt(4)\n    pPr = p._p.get_or_add_pPr()\n    pBdr = OxmlElement('w:pBdr')\n    bottom = OxmlElement('w:bottom')\n    bottom.set(qn('w:val'), 'single')\n    bottom.set(qn('w:sz'), '4')\n    bottom.set(qn('w:space'), '1')\n    bottom.set(qn('w:color'), 'CCCCCC')\n    pBdr.append(bottom)\n    pPr.append(pBdr)\n\ndef add_table_2col(doc, rows):\n    table = doc.add_table(rows=1 + len(rows), cols=2)\n    table.style = 'Table Grid'\n    # Header\n    hdr = table.rows[0].cells\n    for i, h in enumerate([\"Element\", \"Detail\"]):\n        hdr[i].text = h\n        run = hdr[i].paragraphs[0].runs[0]\n        run.bold = True\n        run.font.size = Pt(10)\n        run.font.name = 'Calibri'\n        run.font.color.rgb = RGBColor(0xFF, 0xFF, 0xFF)\n        tc = hdr[i]._tc\n        tcPr = tc.get_or_add_tcPr()\n        shd = OxmlElement('w:shd')\n        shd.set(qn('w:val'), 'clear')\n        shd.set(qn('w:color'), 'auto')\n        shd.set(qn('w:fill'), '1A1A8E')\n        tcPr.append(shd)\n    for ri, (label, value) in enumerate(rows):\n        cells = table.rows[ri+1].cells\n        cells[0].text = label\n        cells[1].text = value\n        fill = 'F0F0FA' if ri % 2 == 0 else 'FFFFFF'\n        for ci in range(2):\n            run = cells[ci].paragraphs[0].runs[0]\n            run.font.size = Pt(10)\n            run.font.name = 'Calibri'\n            if ci == 0:\n                run.bold = True\n            tc = cells[ci]._tc\n            tcPr = tc.get_or_add_tcPr()\n            shd = OxmlElement('w:shd')\n            shd.set(qn('w:val'), 'clear')\n            shd.set(qn('w:color'), 'auto')\n            shd.set(qn('w:fill'), fill)\n            tcPr.append(shd)\n    doc.add_paragraph().paragraph_format.space_after = Pt(4)\n\ndef add_big_table(doc, headers, rows):\n    table = doc.add_table(rows=1 + len(rows), cols=len(headers))\n    table.style = 'Table Grid'\n    hdr = table.rows[0].cells\n    for i, h in enumerate(headers):\n        hdr[i].text = h\n        run = hdr[i].paragraphs[0].runs[0]\n        run.bold = True\n        run.font.size = Pt(9)\n        run.font.name = 'Calibri'\n        run.font.color.rgb = RGBColor(0xFF, 0xFF, 0xFF)\n        tc = hdr[i]._tc\n        tcPr = tc.get_or_add_tcPr()\n        shd = OxmlElement('w:shd')\n        shd.set(qn('w:val'), 'clear')\n        shd.set(qn('w:color'), 'auto')\n        shd.set(qn('w:fill'), '1A1A8E')\n        tcPr.append(shd)\n    for ri, row in enumerate(rows):\n        cells = table.rows[ri+1].cells\n        fill = 'F0F0FA' if ri % 2 == 0 else 'FFFFFF'\n        # Last row (DOJO) — highlight\n        if 'DOJO' in row[0]:\n            fill = 'E8E8FF'\n        for ci, val in enumerate(row):\n            cells[ci].text = val\n            run = cells[ci].paragraphs[0].runs[0]\n            run.font.size = Pt(9)\n            run.font.name = 'Calibri'\n            if ci == 0:\n                run.bold = True\n            if 'DOJO' in row[0]:\n                run.bold = True\n                run.font.color.rgb = RGBColor(0x1A, 0x1A, 0x8E)\n            tc = cells[ci]._tc\n            tcPr = tc.get_or_add_tcPr()\n            shd = OxmlElement('w:shd')\n            shd.set(qn('w:val'), 'clear')\n            shd.set(qn('w:color'), 'auto')\n            shd.set(qn('w:fill'), fill)\n            tcPr.append(shd)\n    doc.add_paragraph().paragraph_format.space_after = Pt(4)\n\ndef threat_label(doc, level, color):\n    p = doc.add_paragraph()\n    p.paragraph_format.space_before = Pt(2)\n    p.paragraph_format.space_after = Pt(6)\n    run = p.add_run(f\"Threat Level: {level}\")\n    run.bold = True\n    run.font.color.rgb = RGBColor(*color)\n    run.font.name = 'Calibri'\n    run.font.size = Pt(10.5)\n\nprint(\"All helpers loaded OK\")\n"}}

