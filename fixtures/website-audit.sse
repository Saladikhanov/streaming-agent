data: {"type": "action", "id": "act7", "icon": "notebook", "title": "Read documentation", "results": [{"icon": "", "title": "Documentation"}], "results_units": "Documentation", "ended_at": "2026-08-01T09:10:43.078066Z", "output": "async def download_from_library(library_path: str, local_path: str | pathlib.Path | None = None) -> bytes | None:\n    \"\"\"Download a file from the library into the sandbox.\n\n    Args:\n        library_path: The library path to the file to download.\n        local_path: Local sandbox path to write the file to. If not provided, the file content is returned as bytes.\n\n    Returns:\n        The file content as bytes when `local_path` is not provided, None otherwise.\n\n    Examples:\n        >>> data = json.loads(await download_from_library(\"uploads/document.json\"))\n\n        >>> await download_from_library(\"uploads/document.xlsx\", \"document.xlsx\")\n        >>> df = pd.read_excel(\"document.xlsx\")\n    \"\"\"\n    ...\n", "has_succeeded": true, "artifacts": []}

